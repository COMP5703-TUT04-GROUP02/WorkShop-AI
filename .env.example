WORKSHOP_JWT_ALGORITHM=RS256
WORKSHOP_JWT_PRIVATE_KEY_PATH=backend/certs/jwt-private.pem
WORKSHOP_JWT_PUBLIC_KEY_PATH=backend/certs/jwt-public.pem
WORKSHOP_ACCESS_TOKEN_EXPIRE_MINUTES=30
WORKSHOP_REFRESH_TOKEN_EXPIRE_DAYS=7

# Google/Apple sign-in. Comma-separated audiences the backend accepts.
# Google: the iOS, Android and Web OAuth client IDs (same as the app's
# EXPO_PUBLIC_GOOGLE_*_CLIENT_ID). Apple: the iOS bundle ID, which is the
# default; add host.exp.Exponent only to test Apple sign-in in Expo Go.
WORKSHOP_GOOGLE_CLIENT_IDS=
WORKSHOP_APPLE_CLIENT_IDS=com.comp5703.workshopai
WORKSHOP_APPLE_TOKEN_ISSUER=https://appleid.apple.com
WORKSHOP_GOOGLE_MAPS_API_KEY=

# Verification emails. "console" only logs the code (no mailbox needed).
# For real mail set "smtp" and fill in WORKSHOP_SMTP_PASSWORD with the App
# Password of the project mailbox 5703.workshop.ai@gmail.com (ask the team;
# never commit it). It is not the normal account password.
WORKSHOP_EMAIL_BACKEND=console
WORKSHOP_SMTP_HOST=smtp.gmail.com
WORKSHOP_SMTP_PORT=587
WORKSHOP_SMTP_USERNAME=5703.workshop.ai@gmail.com
WORKSHOP_SMTP_PASSWORD=
WORKSHOP_EMAIL_FROM=5703.workshop.ai@gmail.com
WORKSHOP_EMAIL_FROM_NAME=Workshop AI

WORKSHOP_DATABASE_URL=postgresql+psycopg://workshop:workshop@127.0.0.1:5436/workshop

WORKSHOP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081,http://localhost:8090,http://127.0.0.1:8090

WORKSHOP_REDIS_HOST=127.0.0.1
WORKSHOP_REDIS_PORT=6379
WORKSHOP_REDIS_DB=0

WORKSHOP_MILVUS_HOST=127.0.0.1
WORKSHOP_MILVUS_PORT=19530
WORKSHOP_MILVUS_REVIEW_COLLECTION=provider_reviews

# Chat uses an OpenAI-compatible API key, or an admin ChatGPT Plus
# device-code login from the Admin dashboard (tokens in backend/certs/).
# LLM_PROVIDER=qwen|openai|claude|kimi|kimi-code|deepseek|grok|custom
LLM_PROVIDER=qwen
# Optional vendor keys. LLM_API_KEY is the generic fallback.
# ANTHROPIC_API_KEY=
# KIMI_API_KEY=
# KIMI_CODE_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# Docker Compose reads this file for chat. Review embeddings default
# to local TEI (Qwen3-Embedding-0.6B) on the Compose network.
LLM_API_KEY=your-api-key-here
# QWEN_API_KEY=
# OPENAI_API_KEY=
# Optional overrides. Leave blank to use the provider preset.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-6.1-sol
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=1

# Compose injects http://tei:80/v1. Uncomment for a host API process
# after `docker compose up -d tei` (host port 8091).
# EMBEDDING_API_KEY=tei
# EMBEDDING_BASE_URL=http://127.0.0.1:8091/v1
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# EMBEDDING_DIMENSION=1024

WORKSHOP_CELERY_BROKER_URL=redis://127.0.0.1:6379/1
WORKSHOP_CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

WORKSHOP_UPLOAD_DIR=backend/uploads
WORKSHOP_MAX_UPLOAD_SIZE_MB=50
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_CALLBACK_URL=http://localhost:8000/payments/iyzico/callback
IYZICO_FRONTEND_RETURN_URL=http://localhost:8090/payment-result
IYZICO_CHECKOUT_TTL_SECONDS=1800
IYZICO_TIMEOUT_SECONDS=15
PLATFORM_COMMISSION_RATE=0.10
